# Connection string de Postgres (Vercel Postgres, Supabase, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/centro_servicio"

# Credenciales del único usuario de la app — se crean con `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="cambia-esta-clave"

# Secreto de NextAuth (obligatorio en producción). Genera uno con:
# openssl rand -base64 32
AUTH_SECRET="genera-un-valor-aleatorio-largo"
